{
  "name": "pao-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3177",
    "build": "next build && node scripts/compress.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts --max-warnings 0",
    "preview": "node scripts/serve.mjs",
    "editor": "node scripts/serve.mjs --editor",
    "test:editor": "node --test scripts/editor.test.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "build:hostinger": "npm run build && node scripts/prepare-hostinger.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "ogl": "1.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "latest",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9"
  },
  "engines": {
    "node": "24.x"
  }
}
